generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ----------------------
// AUTHENTICATION & USER
// ----------------------
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile          UserProfile?
  bodyHistories    BodyStatusHistory[]
  workoutSchedules WorkoutSchedule[]
  workoutSessions  WorkoutSession[]
  nutritionPlan    NutritionPlan?
  chatHistories    ChatHistory[]
}

enum Role {
  USER
  ADMIN
}

// ----------------------
// USER PROFILE & BODY
// ----------------------
model UserProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  height        Float    // Tinggi dalam cm
  weight        Float    // Berat dalam kg
  dateOfBirth   DateTime
  gender        Gender
  targetFitness FitnessGoal
  activityLevel ActivityLevel
  
  // Kalkulasi Otomatis Sistem
  bmr           Float?
  tdee          Float?
  bmi           Float?
  
  updatedAt     DateTime @updatedAt
}

enum Gender {
  MALE
  FEMALE
}

enum FitnessGoal {
  CUTTING
  BULKING
  MAINTAIN
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

model BodyStatusHistory {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight     Float    // kg
  bmi        Float
  status     BodyStatus
  recordedAt DateTime @default(now())
}

enum BodyStatus {
  UNDERWEIGHT
  NORMAL
  OVERWEIGHT
  OBESE
}

// ----------------------
// WORKOUT & EXERCISES
// ----------------------
model Exercise {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  category    String
  muscleGroup String
  
  workoutExercises WorkoutExercise[]
}

model WorkoutSchedule {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  dayOfWeek Int      // 0 (Minggu) sampai 6 (Sabtu)
  
  sessions  WorkoutSession[]
}

model WorkoutSession {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleId  Int?
  schedule    WorkoutSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  date        DateTime
  status      SessionStatus @default(PLANNED)
  bodyWeight  Float?        // Berat badan harian user (kg) pada hari latihan
  missedReason String?       // Alasan tidak latihan (misal: Sakit, Sibuk, Malas, Lainnya)
  
  exercises   WorkoutExercise[]
}

enum SessionStatus {
  PLANNED
  COMPLETED     // Sudah latihan
  REST_DAY      // Hari istirahat
  MISSED        // Tidak latihan
}

model WorkoutExercise {
  id          Int      @id @default(autoincrement())
  sessionId   Int
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId  Int
  exercise    Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  
  sets        Int
  reps        Int
  weight      Float          // Beban angkatan dalam kg
  completed   Boolean        @default(false)
}

// ----------------------
// NUTRITION SYSTEM
// ----------------------
model NutritionPlan {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCalories Int
  protein       Float    // grams
  carbs         Float    // grams
  fat           Float    // grams
  updatedAt     DateTime @updatedAt
}

// ----------------------
// AI CHATBOT HISTORY
// ----------------------
model ChatHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ChatRole // USER atau ASSISTANT
  content   String   @db.Text
  createdAt DateTime @default(now())
}

enum ChatRole {
  USER
  ASSISTANT
}
